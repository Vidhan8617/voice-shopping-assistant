# Copy this file to .env and fill in your own values.

# Get a free key at https://console.groq.com — the app works without it
# (falls back to rule-based parsing only) but multilingual/flexible
# phrasing needs it.
GROQ_API_KEY=

# Leave as default for local dev. In production, point at Postgres, e.g.:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./shopping_assistant.db

# Comma-separated list gets parsed by pydantic; for local dev this is fine as-is.
CORS_ORIGINS=["http://localhost:5173"]
